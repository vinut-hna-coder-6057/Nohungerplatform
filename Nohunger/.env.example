# Server
PORT=4000

# Database
# Request status changes require MongoDB transactions (replica set or sharded cluster).
MONGO_URI=mongodb://localhost:27017/nohunger?replicaSet=rs0

# JWT
# Replace this placeholder with a unique, randomly generated secret before running.
JWT_SECRET=your_jwt_secret_here

# Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=your_bcrypt_hash_here

# Frontend
ALLOWED_ORIGIN=http://localhost:4000

# Email
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Rate limiting
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# The built-in limiter is process-local. Use one application instance unless
# it is replaced with a shared store such as Redis.
RATE_LIMIT_STORE=memory

# Upload storage
# The app stores uploaded images in Nohunger/uploads; production must mount durable storage there.
