    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "multer": "^2.5.0",
    "nodemailer": "^10.1.7",
    "sharp": "^0.35.5",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
